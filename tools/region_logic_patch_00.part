@@ -95,11 +95,14 @@ def _normalized_point(override, shape):
 
 
 def _boundary_reference(values, foreground, region):
-    ring = ndi.binary_dilation(region, iterations=2) & foreground & ~region
-    sample = values[ring]
+    """Estimate the carrier surface without sampling the dark boundary groove."""
